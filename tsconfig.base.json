{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@org/source"],
    "noUncheckedSideEffectImports": false,
    "types": ["*"],
    "baseUrl": ".",
   "paths": {
  "@codigate/domain": [
    "packages/domain"
  ],
  "@codigate/application": [
    "packages/application"
  ],
  "@codigate/core": [
    "packages/core"
  ],
  "@codigate/shared": [
    "packages/shared"
  ]
}
  }
}
